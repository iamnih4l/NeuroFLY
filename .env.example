# NeuroFly Environment Configuration

# 1. LIVE NEWS INGESTION
# Get a YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=
YOUTUBE_NEWS_QUERY="live news"
YOUTUBE_DISCOVERY_INTERVAL_MINUTES=15

# Legacy NewsAPI (Fallback)
NEWS_API_KEY=your_newsapi_key_here

# 2. SIMULATION
# Run backend node server in development mode (mocks API calls)
NEUROFLY_ENV=production

# 3. CONNECTOME DATA PIPELINE
# Get an Auth token from https://neuprint.janelia.org/account
NEUPRINT_TOKEN="your_neuprint_token_here"
